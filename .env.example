SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_me
SUPABASE_SECRET_KEY=replace_with_server_only_secret_key
USUARIOS_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# OpenAI vision review of doubtful white-spot candidates (server only, model gpt-5.6-luna).
# Without this key the local OpenCV analysis keeps working unchanged.
OPENAI_API_KEY=replace_me

# TypeSafe Jev triage of doubtful candidates from their OpenCV measurements
# (server only, model jev-latest). Without this key every doubtful point goes
# straight to the vision review.
TYPESAFE_API_KEY=replace_me

# Cloudinary (unsigned). VITE_ names also work.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
